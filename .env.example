# Підключення до бази (роль swarm / пароль swarm / база ai_agent_swarm)
DATABASE_URL=postgresql://swarm:swarm@localhost:5432/ai_agent_swarm

# Порти/адреси
BACKEND_PORT=4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Доступ до Claude (Agent SDK). Достатньо ОДНОГО зі способів:
#  1) CLAUDE_CODE_OAUTH_TOKEN — згенеруйте командою `claude setup-token`.
#  2) ANTHROPIC_API_KEY — звичайний API-ключ Anthropic.
#  Якщо обидва порожні, але ви увійшли в Claude Code на цій машині
#  (`claude /login`), SDK використає цей збережений логін автоматично.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=


# Telegram (необовʼязково). chat_id власника: `npm run telegram:chat-id`.
# Якщо задано обидва — вмикається ДВОСТОРОННІЙ режим (Фаза 5): бекенд через
# long-polling приймає повідомлення власника й маршрутизує (Стратег за
# замовчуванням; /agent <slug> …, /task …, /idea …, /project <slug>).
# Публікація в канал — chat_id каналу вказується у Профілі проєкту (не тут).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Пароль на дашборд. Порожній — авторизацію вимкнено.
SWARM_PASSWORD=

# Таймаут одного виклику агента, мс (захист від «зависання»). Типово 180000.
AGENT_TIMEOUT_MS=180000

# Окремий таймаут для image-capable агента (Дизайнер) — має покривати
# послідовні CLI-виклики Higgsfield для каруселі. Типово 1800000 (30 хв).
IMAGE_AGENT_TIMEOUT_MS=1800000

# Higgsfield — генерація зображень Дизайнером (обкладинки/каруселі).
# Інтеграція через CLI зі ЗБЕРЕЖЕНОЮ СЕСІЄЮ (не API-ключ), як логін Claude:
#   1) встановити CLI:  curl -fsSL https://raw.githubusercontent.com/higgsfield-ai/cli/main/install.sh | sh
#   2) увійти один раз: higgsfield auth login
# HIGGSFIELD_BIN — шлях до CLI, якщо він не у PATH (типово "higgsfield").
# HIGGSFIELD_IMAGE_MODEL — модель за замовчуванням (типово text2image_soul_v2 — Soul 2.0).
# HIGGSFIELD_TIMEOUT_MS — таймаут однієї генерації, мс (типово 600000).
HIGGSFIELD_BIN=
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_TIMEOUT_MS=
